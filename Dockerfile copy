# 使用官方Node.js镜像
FROM node:22-alpine

# 安装必要的系统依赖
RUN apk add --no-cache python3 make g++

# 设置工作目录
WORKDIR /app

# 设置环境变量禁用lightningcss
ENV LIGHTNINGCSS_DISABLE=1
ENV TAILWIND_MODE=build

# 复制package文件
COPY package*.json ./

# 安装依赖
RUN npm install

# 复制源代码
COPY . .

# 构建应用
RUN npm run build

# 暴露端口
EXPOSE 3000

# 启动应用
CMD ["npm", "start"]